import pandas as pd
from xgboost import XGBClassifier
from flask import Flask, request, jsonify
from flask_cors import CORS  # Add this import
import pickle
import os

app = Flask(__name__)
CORS(app)  # Enable CORS for all routes

# Configure flask app
app.config['MAX_CONTENT_LENGTH'] = 1000 * 1024 * 1024  # Allow up to 1000MB files
app.config['UPLOAD_FOLDER'] = 'tmd_uploads'
os.makedirs(app.config['UPLOAD_FOLDER'], exist_ok=True)

@app.route('/predict', methods=['POST'])
def predict():
    try:
        # Check if file was uploaded
        if 'file' not in request.files:
            return jsonify({'error': 'No file uploaded'}), 400
            
        file = request.files['file']
        if file.filename == '':
            return jsonify({'error': 'No file selected'}), 400
            
        # Save file temporarily
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], 'temp.csv')
        file.save(filepath)
        
        try:
            # Read CSV file
            df = pd.read_csv(filepath, low_memory=False)
            
            # Basic validation
            required_cols = {'Phage_ID', 'Host_ID', 'Phage_GC_Content', 'Host_GC_Content'}
            missing_cols = required_cols - set(df.columns)
            if missing_cols:
                return jsonify({
                    'error': f'Missing required columns: {", ".join(missing_cols)}'
                }), 400

            # Get Phage_Kmer columns
            kmer_cols = [col for col in df.columns if col.startswith('Phage_Kmer_')]
            if not kmer_cols:
                return jsonify({'error': 'No Phage_Kmer columns found'}), 400

            # Prepare features
            feature_cols = ['Phage_GC_Content', 'Host_GC_Content'] + kmer_cols
            X = df[feature_cols]
            
            # Standardize features
            X = (X - X.mean()) / X.std()
            
            # Load model
            model_path = 'xgboost_model.json'
            if not os.path.exists(model_path):
                return jsonify({'error': 'Model file not found'}), 500
                
            model = pickle.load(open(model_path, 'rb'))
            
            # Make predictions
            y_pred = model.predict(X)
            y_prob = model.predict_proba(X)[:, 1]
            
            return jsonify({
                'prediction': y_pred.tolist(),
                'confidence': y_prob.tolist()
            })
            
        except Exception as e:
            return jsonify({'error': f'Error processing file: {str(e)}'}), 400
            
        finally:
            # Clean up
            if os.path.exists(filepath):
                os.remove(filepath)
                
    except Exception as e:
        return jsonify({'error': f'Server error: {str(e)}'}), 500

if __name__ == '__main__':
    app.run(debug=True, port=5000)